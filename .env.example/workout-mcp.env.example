# Static bearer token MCP clients must send as `Authorization: Bearer <token>`.
# Guards /mcp only. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# HTTP Basic Auth for the dashboard at / and its /api routes. This service is
# the only one here with a human-facing UI on a public hostname, and it holds
# real health data -- use a generated password:  openssl rand -base64 18
DASHBOARD_USER=you
DASHBOARD_PASSWORD=generate-a-random-password-here

# Where the SQLite database lives. Backed by the `workout-data` volume in
# docker-compose.yml; nothing upstream holds a copy of this history. Optional.
WORKOUT_DB=/data/workouts.db

# IANA timezone "today" is resolved in. The container runs UTC, so without this
# an evening workout is filed on the following day. Optional, defaults to
# America/Chicago.
WORKOUT_TIMEZONE=America/Chicago
