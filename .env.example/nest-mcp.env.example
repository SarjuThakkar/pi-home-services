# Static bearer token Pebble must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# Device Access project ID (a UUID) from https://console.nest.google.com/device-access
NEST_PROJECT_ID=00000000-0000-0000-0000-000000000000

# OAuth 2.0 client from Google Cloud Console, authorized for the SDM API.
NEST_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEST_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# From `python3 get_refresh_token.py` in the nest-thermostat-mcp repo. Mint it
# only AFTER publishing the OAuth consent screen to production -- a token issued
# while the app is in Testing is revoked by Google every 7 days.
NEST_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx
