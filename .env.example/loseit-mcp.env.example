# Your loseit.com login. The server signs in with these directly -- there is
# no OAuth to set up, and no reCAPTCHA token is needed.
LOSEIT_EMAIL=you@example.com
LOSEIT_PASSWORD=changeme

# Static bearer token clients must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# IANA timezone "today" is resolved in. Optional, defaults to America/Chicago.
LOSEIT_TIMEZONE=America/Chicago

# Where the signed-in session is cached. Lose It!'s sign-in endpoint is
# Cloudflare rate-limited (HTTP 429, error 1015), so this file is what keeps a
# restart from burning a login. Optional.
LOSEIT_SESSION=/session/loseit_session.json

# The compiled GWT module the web app serves. These identify the build whose
# serialization policy every RPC is encoded against, and they change when Lose
# It! redeploys the web app -- see README "When it breaks". All optional;
# defaults are the values verified live on 2026-09-01.
# LOSEIT_GWT_MODULE_BASE=https://d3hsih69yn4d89.cloudfront.net/web/
# LOSEIT_GWT_STRONG_NAME=108644F06370DEF41E9A7D9DFEDBBC80
# LOSEIT_GWT_PERMUTATION=0740EF43D22FF4BC274288833AA500A3
