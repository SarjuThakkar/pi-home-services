# Static bearer token Pebble must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# Persistent Chromium profile -- this IS the signed-in Goodreads session.
GOODREADS_PROFILE=/profile
GOODREADS_QUEUE=/profile/queue.json

# Seconds the headed sign-in window waits for a human at the touchscreen.
GOODREADS_AUTH_TIMEOUT=600
